# The seeded backend data is one clinic day, 26 Sep 2026 (see ../hospital backend);
# pin "today" to it so schedules line up, like the web app. Remove for the real date.
EXPO_PUBLIC_CLINIC_DATE=2026-09-26

# Backend URL. Defaults: http://10.0.2.2:4000/api on the Android emulator,
# http://localhost:4000/api on the iOS simulator. A phone needs your computer's LAN IP.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api
